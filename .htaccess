ErrorDocument 404 /index.html
AddDefaultCharset UTF-8

Redirect 301 /alte-seite.html https://www.stsc.at/

RewriteEngine On

# Canonical: /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\?\s]|$) [NC]
RewriteRule ^index\.html$ https://www.stsc.at/ [R=301,L]

# Canonical: force www host
RewriteCond %{HTTP_HOST} !^www\.stsc\.at$ [NC]
RewriteRule ^ https://www.stsc.at%{REQUEST_URI} [R=301,L]


