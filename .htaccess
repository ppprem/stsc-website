ErrorDocument 404 /index.html
AddDefaultCharset UTF-8

Redirect 301 /alte-seite.html https://www.stsc.at/
Redirect 301 /picture_library/Silvia.webp https://www.stsc.at/picture_library/silvia-christine-bors-psychotherapie-wien.webp

RewriteEngine On

# Canonical: /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\?\s]|$) [NC]
RewriteRule ^index\.html$ https://www.stsc.at/ [R=301,L]

# Canonical: force www host
RewriteCond %{HTTP_HOST} !^www\.stsc\.at$ [NC]
RewriteRule ^ https://www.stsc.at%{REQUEST_URI} [R=301,L]


